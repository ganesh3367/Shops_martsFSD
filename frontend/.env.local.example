# Copy this file to .env.local and fill in your Firebase Web App credentials.
# Get these from: Firebase Console → Project Settings → Your Apps → Web App → SDK Setup

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=travelp-36fbe.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=travelp-36fbe
VITE_FIREBASE_STORAGE_BUCKET=travelp-36fbe.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend URL
VITE_API_URL=http://localhost:5003/api
